[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[interactive]
	diffFilter = delta --color-only 2>/dev/null || cat

[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = false

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

# Local and private configurations (identity, signing keys, etc.)
[include]
	path = ~/.gitconfig.local
